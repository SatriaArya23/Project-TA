[Unit]
Description=Validasi & impor berkas model .joblib ke katalog bersama ASUNA
After=local-fs.target

[Service]
Type=oneshot
User=nids
Group=nids
ExecStart=/opt/nids-deteksi/venv/bin/python /opt/nids-deteksi/impor_model.py --folder /var/lib/nids-bersama/model
UMask=0007

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/nids-bersama
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
Nice=15
CPUQuota=50%
MemoryMax=512M
