[Unit]
Description=NIDS pemantau kesehatan (peringatan Telegram bila deteksi/disk/RAM bermasalah)
After=network-online.target

[Service]
Type=oneshot
User=nids
Group=nids
EnvironmentFile=-/etc/nids-deteksi/config.env
EnvironmentFile=-/etc/nids-deteksi/rahasia.env
ExecStart=/opt/nids-deteksi/venv/bin/python /opt/nids-deteksi/pantau.py
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/nids-deteksi
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
