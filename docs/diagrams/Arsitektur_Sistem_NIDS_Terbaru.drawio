  <diagram name="Gambar 3.4 - Alur Pelatihan &amp; Evaluasi" id="g34_final">
    <mxGraphModel dx="1420" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p0" value="&lt;b&gt;Mulai (Offline di Laptop)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#FFF6E5;strokeColor=#B5751D;strokeWidth=1.4;fontSize=11.5;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="260" y="20" width="260" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;1. Masukan Data&lt;/b&gt;&lt;br&gt;a. Dataset publik CIC-IDS2017 (GeneratedLabelledFlows)&lt;br&gt;b. Arsip rekaman header server VPS perusahaan &amp;amp; VPS uji&lt;br&gt;c. Kasus umpan balik dari dashboard (serangan lolos / alarm palsu)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#B5751D;strokeWidth=1.3;fontSize=11;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="150" y="98" width="480" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;2. Preprocessing &amp;amp; Rekayasa Fitur&lt;/b&gt;&lt;br&gt;Putar ulang rekaman dengan pipa ekstraksi identik → 68 fitur aliran + 7 fitur agregasi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#B5751D;strokeWidth=1.3;fontSize=11;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="150" y="210" width="480" height="62" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;3. Pembersihan Data Latih &amp;amp; Transformasi Log&lt;/b&gt;&lt;br&gt;• Keluarkan sumber intens (≥ 20 port / ≥ 20 SSH per 5 mnt) &amp;amp; subnet terdistribusi&lt;br&gt;• Kasus serangan lolos dikeluarkan; kasus alarm palsu dipertahankan sebagai normal&lt;br&gt;• Terapkan transformasi log sign(x)·ln(1 + |x|) sebelum standardisasi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFBF2;strokeColor=#B5751D;strokeWidth=1.3;fontSize=10.6;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="150" y="302" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;4. Pelatihan Model A &amp;amp; Model C (Isolation Forest)&lt;/b&gt;&lt;br&gt;n_estimators = 100, max_samples = 256, jendela 300 dtk (A = 0,001; C = 0,0075)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF3FC;strokeColor=#1D5B96;strokeWidth=1.3;fontSize=11;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="150" y="424" width="480" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="&lt;b&gt;5. Validasi &amp;amp; Evaluasi&lt;/b&gt;&lt;br&gt;• Validasi rancangan pada CIC-IDS2017 (F1, recall, precision, FPR, ROC-AUC)&lt;br&gt;• Evaluasi lapangan pada VPS perusahaan &amp;amp; simulasi terkendali di VPS uji" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#B5751D;strokeWidth=1.3;fontSize=10.8;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="150" y="518" width="480" height="76" as="geometry" />
        </mxCell>
        <mxCell id="pd1" value="&lt;b&gt;Kinerja validasi&lt;/b&gt;&lt;br&gt;&lt;b&gt;memadai?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBF2;strokeColor=#B5751D;strokeWidth=1.4;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="230" y="626" width="320" height="78" as="geometry" />
        </mxCell>
        <mxCell id="ptun" value="&lt;b&gt;Penalaan Parameter&lt;/b&gt;&lt;br&gt;Contamination A/C, panjang&lt;br&gt;jendela, &amp;amp; varian fitur" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=1.3;fontSize=10.8;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="640" y="630" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="&lt;b&gt;6. Simpan Model Versi Baru (.joblib)&lt;/b&gt;&lt;br&gt;Model A+C, nilai ambang, kuantil skor latih, metadata versi &amp;amp; hasil evaluasi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E6F6F0;strokeColor=#23735F;strokeWidth=1.3;fontSize=11;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="150" y="742" width="480" height="62" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="&lt;b&gt;7. Pasang ke VPS Uji → Uji Simulasi → Pasang ke VPS Perusahaan&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#23735F;strokeWidth=1.3;fontSize=11;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="150" y="836" width="480" height="56" as="geometry" />
        </mxCell>
