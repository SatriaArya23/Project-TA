        <mxCell id="z2_t" value="&lt;b&gt;Zona 2 — Laptop Peneliti&lt;/b&gt;&lt;br&gt;&lt;i&gt;Offline: validasi metode, pelatihan model, simulasi &amp;amp; evaluasi&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1">
