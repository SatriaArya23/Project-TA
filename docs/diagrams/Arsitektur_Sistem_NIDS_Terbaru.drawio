        <mxCell id="z3_t" value="&lt;b&gt;Zona 3 — VPS Uji Peneliti&lt;/b&gt;&lt;br&gt;&lt;i&gt;Uji sistem &amp;amp; simulasi serangan&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="709" y="478" width="215" height="38" as="geometry" />
        </mxCell>
        <mxCell id="net1" value="&lt;b&gt;Internet&lt;/b&gt;&lt;br&gt;Pengunjung &amp;amp; penyerang nyata" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.3;fontSize=11.5;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="215" y="18" width="240" height="52" as="geometry" />
        </mxCell>
        <mxCell id="L1" value="&lt;b&gt;1. Penangkap Paket&lt;/b&gt;&lt;br&gt;tcpdump pada antarmuka jaringan&lt;br&gt;hanya header ≤ 160 byte (tanpa payload)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2C5A87;strokeWidth=1.3;fontSize=11.5;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="50" y="160" width="310" height="62" as="geometry" />
        </mxCell>
        <mxCell id="Lrec" value="&lt;b&gt;Perekam &amp;amp; Modul Penerima&lt;/b&gt;&lt;br&gt;rekaman per jam, payload dinolkan,&lt;br&gt;HTTPS + token + SHA-256" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.3;fontSize=11;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="395" y="155" width="180" height="72" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="&lt;b&gt;2. Penyusun Aliran &amp;amp; Ekstraksi Fitur&lt;/b&gt;&lt;br&gt;68 fitur aliran (aturan CICFlowMeter)&lt;br&gt;+ 7 fitur agregasi IP/subnet (jendela 300 dtk)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2C5A87;strokeWidth=1.3;fontSize=11.5;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="50" y="252" width="310" height="62" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="&lt;b&gt;3. Modul Deteksi Isolation Forest&lt;/b&gt;&lt;br&gt;Model A (aliran) OR Model C (perilaku sumber),&lt;br&gt;transformasi log; hanya aliran masuk dinilai" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF3FC;strokeColor=#1D5B96;strokeWidth=1.3;fontSize=11.5;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="50" y="344" width="310" height="76" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="&lt;b&gt;4. Log Anomali &amp;amp; Ringkasan (SQLite)&lt;/b&gt;&lt;br&gt;deteksi.db: skor semua aliran, anomali,&lt;br&gt;ringkasan/menit, versi model, latensi notif" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2C5A87;strokeWidth=1.3;fontSize=11.5;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="50" y="452" width="310" height="62" as="geometry" />
        </mxCell>
        <mxCell id="Ltp" value="&lt;b&gt;IP Tepercaya (Whitelist)&lt;/b&gt;&lt;br&gt;berkas JSON bersama:&lt;br&gt;tidak ditandai &amp;amp; tidak dinotif" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.3;fontSize=11;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="395" y="452" width="180" height="62" as="geometry" />
        </mxCell>
        <mxCell id="L5" value="&lt;b&gt;5. Notifikasi &amp;amp; Bot Telegram&lt;/b&gt;&lt;br&gt;≥ 3 anomali/5 mnt atau A+C,&lt;br&gt;jeda 10 mnt/IP; perintah bot&lt;br&gt;baca-saja (/status, /ringkasan,&lt;br&gt;/ip, /hampir)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2C5A87;strokeWidth=1.3;fontSize=10.8;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="50" y="570" width="195" height="108" as="geometry" />
        </mxCell>
        <mxCell id="Lmon" value="&lt;b&gt;Pemantau&lt;/b&gt;&lt;br&gt;systemd timer 2 mnt:&lt;br&gt;cek layanan, detak,&lt;br&gt;CPU, RAM &amp;amp; disk" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.3;fontSize=10.5;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="570" width="125" height="108" as="geometry" />
        </mxCell>
        <mxCell id="L6" value="&lt;b&gt;6. Dashboard Web&lt;/b&gt;&lt;br&gt;Flask + HTTPS (Nginx):&lt;br&gt;Ringkasan, Anomali,&lt;br&gt;Hampir Anomali, Model,&lt;br&gt;Umpan Balik &amp;amp; RBAC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2C5A87;strokeWidth=1.3;fontSize=10.8;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="400" y="570" width="175" height="108" as="geometry" />
        </mxCell>
        <mxCell id="adm1" value="&lt;b&gt;Administrator &amp;amp; Tim IT&lt;/b&gt;&lt;br&gt;PT Hotdog Water Sport" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E8F1FA;strokeColor=#2C5A87;strokeWidth=1.3;fontSize=11.5;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="155" y="800" width="315" height="56" as="geometry" />
        </mxCell>
        <mxCell id="M1" value="&lt;b&gt;Arsip Rekaman &amp;amp; Dataset&lt;/b&gt;&lt;br&gt;Dataset publik CIC-IDS2017 berlabel,&lt;br&gt;rekaman header VPS perusahaan &amp;amp; VPS uji" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#B5751D;strokeWidth=1.3;fontSize=11;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="715" y="155" width="250" height="72" as="geometry" />
        </mxCell>
        <mxCell id="M2" value="&lt;b&gt;Pelatihan &amp;amp; Penalaan Model&lt;/b&gt;&lt;br&gt;Pipa ekstraksi fitur identik (putar ulang),&lt;br&gt;pembersihan sumber/subnet intens,&lt;br&gt;transformasi log, latih Model A &amp;amp; C,&lt;br&gt;validasi CIC-IDS2017 &amp;amp; umpan balik" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF6E5;strokeColor=#B5751D;strokeWidth=1.3;fontSize=10.8;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="715" y="268" width="250" height="118" as="geometry" />
        </mxCell>
        <mxCell id="M3" value="&lt;b&gt;Evaluasi Metrik &amp;amp; Latensi&lt;/b&gt;&lt;br&gt;Precision, recall, F1-score, FPR,&lt;br&gt;ROC-AUC, latensi deteksi &amp;amp; notifikasi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#B5751D;strokeWidth=1.3;fontSize=11;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
