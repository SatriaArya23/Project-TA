        <mxCell id="M4" value="&lt;b&gt;Simulasi Serangan Terkendali&lt;/b&gt;&lt;br&gt;Skenario normal, port scan, port scan&lt;br&gt;lambat, SSH brute force, HTTP flood&lt;br&gt;(target dikunci ke VPS uji;&lt;br&gt;jadwal dicatat sebagai kunci jawaban)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#B5751D;strokeWidth=1.3;fontSize=10.8;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
