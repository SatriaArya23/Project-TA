        <mxCell id="z1_t" value="&lt;b&gt;Zona 1 — Server VPS PT Hotdog&lt;/b&gt;&lt;br&gt;&lt;i&gt;Deteksi real-time lalu lintas nyata&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1">
