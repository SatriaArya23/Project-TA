        </mxCell>
        <mxCell id="sd3" value="&lt;b&gt;Terdeteksi dalam&lt;/b&gt;&lt;br&gt;&lt;b&gt;batas aman?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBF2;strokeColor=#B5751D;strokeWidth=1.4;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="650" y="930" width="290" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;b&gt;8. Terapkan Ambang Baru&lt;/b&gt;&lt;br&gt;ubah_ambang.py → model versi baru&lt;br&gt;(tanpa melatih ulang pohon)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E6F6F0;strokeColor=#23735F;strokeWidth=1.3;fontSize=10.8;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
