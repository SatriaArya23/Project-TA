  <diagram name="Gambar 3.3 - Alur Real-Time Server VPS" id="g33_final">
    <mxGraphModel dx="1420" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="1170" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s0" value="&lt;b&gt;(Mulai) Lalu Lintas Masuk Internet&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#EAF3FC;strokeColor=#2C5A87;strokeWidth=1.4;fontSize=11.5;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="240" y="20" width="300" height="48" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1. Penangkap Paket&lt;/b&gt;&lt;br&gt;tcpdump: hanya header ≤ 160 byte per paket" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2C5A87;strokeWidth=1.3;fontSize=11.5;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="210" y="96" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="srec" value="&lt;b&gt;Perekam Arsip (Cabang)&lt;/b&gt;&lt;br&gt;Rekaman per jam, payload dinolkan,&lt;br&gt;kirim HTTPS + token + SHA-256" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=1.3;fontSize=11.5;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="640" y="92" width="300" height="68" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. Penyusun Aliran &amp;amp; Ekstraksi Fitur&lt;/b&gt;&lt;br&gt;68 fitur aliran + 7 fitur agregasi (jendela 300 dtk)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2C5A87;strokeWidth=1.3;fontSize=11.5;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="210" y="186" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. Modul Deteksi Isolation Forest&lt;/b&gt;&lt;br&gt;Transformasi log; hitung skor Model A (aliran)&lt;br&gt;dan Model C (perilaku IP/subnet)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF3FC;strokeColor=#1D5B96;strokeWidth=1.3;fontSize=11.5;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="210" y="274" width="360" height="74" as="geometry" />
        </mxCell>
        <mxCell id="sd1" value="&lt;b&gt;Skor A &amp;gt; ambang A ATAU&lt;/b&gt;&lt;br&gt;&lt;b&gt;skor C &amp;gt; ambang C?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBF2;strokeColor=#B5751D;strokeWidth=1.4;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="215" y="376" width="350" height="82" as="geometry" />
        </mxCell>
        <mxCell id="stp" value="&lt;b&gt;IP sumber ada di&lt;/b&gt;&lt;br&gt;&lt;b&gt;IP Tepercaya?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBF2;strokeColor=#B5751D;strokeWidth=1.4;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="230" y="490" width="320" height="78" as="geometry" />
        </mxCell>
        <mxCell id="snorm" value="&lt;b&gt;Catat Skor Biasa&lt;/b&gt;&lt;br&gt;disimpan ke deteksi.db&lt;br&gt;(tanpa tanda anomali)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=1.3;fontSize=10.3;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="16" y="434" width="168" height="74" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. Log Anomali (SQLite)&lt;/b&gt;&lt;br&gt;Simpan detail anomali, skor, ringkasan/mnt, versi model" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2C5A87;strokeWidth=1.3;fontSize=11.5;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="210" y="604" width="360" height="62" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. Notifikasi &amp;amp; Bot Telegram&lt;/b&gt;&lt;br&gt;≥ 3 anomali/5 mnt atau A+C,&lt;br&gt;jeda 10 mnt/IP; bot baca-saja&lt;br&gt;&amp;amp; pemantau kesehatan 2 mnt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2C5A87;strokeWidth=1.3;fontSize=10.5;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="25" y="708" width="225" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;6. Dashboard Web (Flask + HTTPS)&lt;/b&gt;&lt;br&gt;Ringkasan, Anomali, Hampir Anomali,&lt;br&gt;Cari IP, Model, IP Tepercaya &amp;amp; RBAC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2C5A87;strokeWidth=1.3;fontSize=10.5;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="275" y="708" width="295" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sd2" value="&lt;b&gt;Ada serangan lolos&lt;/b&gt;&lt;br&gt;&lt;b&gt;atau alarm palsu?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBF2;strokeColor=#B5751D;strokeWidth=1.4;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="255" y="824" width="335" height="78" as="geometry" />
        </mxCell>
        <mxCell id="sloop" value="&lt;b&gt;Kembali Memantau&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=1.3;fontSize=11.5;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="25" y="832" width="175" height="62" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;b&gt;7. Laporan Umpan Balik &amp;amp; Periksa Ulang&lt;/b&gt;&lt;br&gt;Nilai ulang skor di deteksi.db dengan ambang kuantil aman" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2C5A87;strokeWidth=1.3;fontSize=10.8;fontColor=#0F172A;spacing=4;" vertex="1" parent="1">
